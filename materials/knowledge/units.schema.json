{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAA micro learning units v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "group",
          "objective",
          "estimated_minutes",
          "scope",
          "prerequisites",
          "misconceptions",
          "checks",
          "lesson_ids",
          "review",
          "learner_state",
          "next_enrichment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "estimated_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "misconceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "level",
                "prompt",
                "expected_points"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "enum": [
                    "explain",
                    "apply"
                  ]
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_points": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 2
                }
              }
            }
          },
          "lesson_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "basis",
              "source_document"
            ],
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "reviewed"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "source_document": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "checked_on",
                    "claim",
                    "reviewer"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "checked_on": {
                      "type": "string",
                      "format": "date"
                    },
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewer": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "reviewed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "evidence"
                  ]
                }
              }
            ]
          },
          "learner_state": {
            "const": "unassessed"
          },
          "next_enrichment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
