  "terms": [
    {
      "id": "health-check",
      "name": "ヘルスチェック",
      "meaning": "ヘルスチェックは処理先の応答を定期的に確認します。異常検出には時間がかかり、全ターゲット異常時にはALBのフェイルオープンという例外もあります。",
      "source": "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/target-group-health-checks.html"
    },
    {
      "id": "alb",
      "name": "Application Load Balancer",
      "meaning": "ALBは正常な処理先へHTTP要求を振り分けます。正常先が残り、その側で必要なデータと容量が使えることが必要です。全ターゲットが異常なら全体に送る例外もあります。",
      "source": "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/target-group-health-checks.html"
    },
    {
      "id": "remaining-capacity",
      "name": "残存容量",
      "meaning": "各AZが100件/秒、需要が160件/秒なら、片方のAZ停止後は60件/秒不足します。障害後に残る側の容量も設計します（教材の仮定値）。",
      "source": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/aws-regions-availability-zones.html"
    }
  ],
  "quizzes": {
    "study-region-failure": {
      "prompt": "同じリージョンの複数AZにEC2を配置しました。リージョン全体の停止への備えとして、この配置だけで十分ですか？",
      "options": [
        "十分。AZが異なればリージョンの影響は受けない",
        "不十分。別リージョンでの復旧や複製・切り替えを別に設計する",
        "ALBを追加すれば必ず別リージョンへ移る"
      ],
      "answer": 1,
      "reasons": [
        "同じリージョンの中の分散です。",
        "リージョン全体の停止はAZ障害とは異なる設計条件です。",
        "ALBだけで別リージョンへの復旧を完結できません。"
      ],
      "source": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/aws-regions-availability-zones.html"
    },
    "study-alb-failopen": {
      "prompt": "ALBの全ターゲットが異常と判定された場合、どうなり得ますか？",
      "options": [
        "全ターゲットへ要求を振り分ける（フェイルオープン）",
        "異常なサーバーは必ず自動修復される",
        "ALBがデータベースの代わりに全要求を処理する"
      ],
      "answer": 0,
      "reasons": [
        "全ターゲット異常時にはフェイルオープンという例外があります。",
        "チェックや振り分けだけでサーバーを必ず修復するわけではありません。",
        "ALBはデータやアプリ処理を代替しません。"
      ],
      "source": "https://docs.aws.amazon.com/elasticloadbalancing/latest/application/target-group-health-checks.html"
    },
    "study-data-access": {
      "prompt": "写真をEC2ローカルだけに保存していたため、AZ障害で別AZの正常なEC2へ切り替えても処理を継続できなかった。写真はアプリからオブジェクトAPIで利用できる。次の構成改善で必要なのは。",
      "options": [
        "ALBのヘルスチェック間隔を短くする",
        "別AZのEC2の処理容量を増やす",
        "写真をS3等へ保存し、切替先のロールと経路から読めるようにする"
      ],
      "answer": 2,
      "reasons": [
        "異常検知は速くなるが、失われたAZの写真へ切替先からアクセスできるようにはならない。",
        "残存計算容量は増えるが、必要データを取得できない問題は解消しない。",
        "計算先の切替に加え、AZ障害後にも必要なデータを権限・経路込みで利用できる設計が必要。"
      ],
      "source": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/aws-regions-availability-zones.html"
    }
  },
